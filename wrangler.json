{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecbc-club",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecbc-db",
      "database_id": "8e0c2826-d881-41b0-805a-95a2edf8ac0f",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://ecbc-club.ecbc-seunghyeon.workers.dev/api/google/callback"
  }
}
